<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[MatchService.Application.Models]*,[MatchService.Infrastructure.EntityFramework]MatchService.Infrastructure.EntityFramework.Migrations.*,[MatchService.WebHost]Program,[MatchService.WebHost]MatchService.WebHost.Heplers.MigrationManager</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
